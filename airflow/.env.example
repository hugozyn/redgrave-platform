# Copy to .env and fill in. .env is NOT committed.
SNOWFLAKE_ACCOUNT=ABCDEFG-XY12345
SNOWFLAKE_USER=YOUR_USER
# ABSOLUTE path of the folder on your computer that contains rsa_key.p8
# macOS example: /Users/you/redgrave/keys      Windows example: C:/Users/you/redgrave/keys
REDGRAVE_KEYS_DIR=/Users/you/redgrave/keys
# Postgres user on your computer (macOS Homebrew: your macOS user name; Windows/Linux installer: postgres)
PGUSER=postgres
PGPASSWORD=
